# =============================================
# EduClip 환경변수 템플릿
# 실제 값은 웹 관리자 화면(GUI Secrets Manager)에서 설정합니다.
# 이 파일을 .env로 복사 후 로컬 개발 시에만 사용하세요.
# =============================================

# --- 데이터베이스 ---
DATABASE_URL=postgresql://educlip_user:change_me@localhost:5432/educlip_db

# --- 서버 ---
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars

# --- AI / LLM API 키 (GUI Secrets Manager에서 암호화 저장 권장) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- 알림 ---
SLACK_WEBHOOK_URL=

# --- 외부 시스템 연동 ---
LMS_API_URL=https://api.example-lms.com
LMS_API_KEY=
ATTENDANCE_API_URL=https://api.example-attendance.com
ATTENDANCE_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- MCP 게이트웨이 ---
MCP_GATEWAY_PORT=3001

# --- 에이전트 실행 제한 ---
HEARTBEAT_MAX_CONCURRENT_RUNS=3
# 스케줄 재시도 잠금 만료 임계치 (ms, 기본 10분)
HEARTBEAT_STALE_LOCK_MS=600000

# --- 타임존 ---
# Heartbeat cron 스케줄러가 시스템 로컬 시각 기준으로 동작합니다.
# 컨테이너 기본값은 UTC이므로 KST 운영 시 반드시 설정하십시오.
# docker-compose.yml에 TZ: ${TZ:-Asia/Seoul} 이 기본 적용되어 있습니다.
TZ=Asia/Seoul
